# The frozen MP protocol and producer hashes refer to exact LF file bytes.
# Preserve them even when a checkout has core.autocrlf enabled.
/docs/mp-*-protocol.md text eol=lf
/src/mp_audit.jl text eol=lf
/src/compositions.jl text eol=lf
/scripts/export_mp_pilot.py text eol=lf

# Repository-maintenance helpers are not part of source distributions.
/bot export-ignore
/bot/** export-ignore
/logs export-ignore
/logs/** export-ignore
